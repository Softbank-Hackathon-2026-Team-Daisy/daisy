# sample-monolith(HelloCalc) 값 예시예요. 비밀값은 넣지 않아요.
# 러너는 deploy.yaml로 같은 내용의 JSON을 만들어 써요 (infra/jenkins/render-tfvars.py).
#   terraform plan -var-file=hellocalc.tfvars -var="image_tag=<커밋 해시 40자>"
# secrets가 있으면 파일이 아니라 환경변수로 넘겨요: TF_VAR_secrets='{"KEY":"value"}'

name        = "hellocalc"
image       = "docker.io/<계정>/hellocalc"
port        = 8080
healthcheck = "/health"
database    = false

# 고정 네트워크: infra/bootstrap/aws-network의 출력 (러너는 targets/aws.json에서 가져와요)
vpc_id             = "vpc-0123456789abcdef0"
public_subnet_ids  = ["subnet-0aaaaaaaaaaaaaaaa", "subnet-0bbbbbbbbbbbbbbbb"]
private_subnet_ids = ["subnet-0cccccccccccccccc", "subnet-0dddddddddddddddd"]
