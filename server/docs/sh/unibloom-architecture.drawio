        <mxCell id="title" value="UNIBLOOM | 프론트·백엔드·인프라 전체 구성" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#142D4E;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1710" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="동일한 앱 이미지를 4개 환경으로 배포 · 서버는 승인과 실행을 관리하고, Jenkins가 AI·Terraform을 실행해요" style="text;html=1;align=left;fontSize=17;fontColor=#516175;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1710" height="35" as="geometry"/></mxCell>
        <mxCell id="clientGroup" value="사용자 / 프론트엔드" style="swimlane;html=1;startSize=45;rounded=1;fillColor=#EAF2FF;swimlaneFillColor=#F7FAFF;strokeColor=#ADC7EB;fontSize=19;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="925" as="geometry"/></mxCell>
        <mxCell id="onpremGroup" value="온프레미스 · Proxmox / pfSense 네트워크 경계" style="swimlane;html=1;startSize=45;rounded=1;fillColor=#E8F1EC;swimlaneFillColor=#FAFCFA;strokeColor=#9DBFA9;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="850" height="925" as="geometry"/></mxCell>
        <mxCell id="serviceVm" value="Service VM · 172.16.1.5" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#EAF2FF;swimlaneFillColor=#FFFFFF;strokeColor=#ADC7EB;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="370" height="845" as="geometry"/></mxCell>
        <mxCell id="ciVm" value="CI/CD VM · 172.16.2.5" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#FFF0DA;swimlaneFillColor=#FFFCF7;strokeColor=#D7AF70;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="210" width="390" height="640" as="geometry"/></mxCell>
        <mxCell id="externalGroup" value="외부 서비스" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#EFEAFA;swimlaneFillColor=#FCFAFF;strokeColor=#BEAED7;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="510" height="300" as="geometry"/></mxCell>
        <mxCell id="cloudGroup" value="퍼블릭 클라우드 · 배포 대상 3개" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#F0F3F7;swimlaneFillColor=#FCFDFE;strokeColor=#B6C2D0;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="485" width="510" height="590" as="geometry"/></mxCell>
        <mxCell id="clients" value="&lt;b&gt;웹 / 네이티브 앱&lt;/b&gt;&lt;br&gt;&lt;br&gt;웹: React · Vite · TypeScript&lt;br&gt;앱: iOS / macOS&lt;br&gt;&lt;br&gt;빌드·대상 선택 / plan 승인&lt;br&gt;진행 로그 / 결과 / 이력" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C9ED6;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="240" height="205" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;HTTPS 공개 · ngrok&lt;/b&gt;&lt;br&gt;&lt;br&gt;www.unibloom.cloud&lt;br&gt;api.unibloom.cloud&lt;br&gt;&lt;br&gt;REST: Bearer 인증&lt;br&gt;SSE: 상태·로그 수신" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6C9ED6;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="240" height="175" as="geometry"/></mxCell>
        <mxCell id="clientNote" value="&lt;b&gt;브라우저 실행과 웹 호스팅은 별개&lt;/b&gt;&lt;br&gt;&lt;br&gt;nginx가 정적 파일을 전달하고&lt;br&gt;브라우저가 API를 호출해요.&lt;br&gt;&lt;br&gt;SSE 재연결: Last-Event-ID&lt;br&gt;heartbeat 15초&lt;br&gt;조회 폴링 대안 5초" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCD9EA;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="815" width="240" height="190" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;프론트 정적 호스팅&lt;/b&gt;&lt;br&gt;nginx · web/dist&lt;br&gt;Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6C9ED6;fontSize=17;" vertex="1" parent="1"><mxGeometry x="390" y="275" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="server" value="&lt;b&gt;Spring Boot API · 단일 서버&lt;/b&gt;&lt;br&gt;Java 21 · Spring MVC · Docker Compose&lt;br&gt;&lt;br&gt;인증 / 프로젝트 / 빌드 / 조회&lt;br&gt;배포 접수 / 승인 / 취소 / 재시도 / 롤백&lt;br&gt;멱등성 / state 락 / 실패 복구&lt;br&gt;Jenkins 명령 워커 / 결과 수신&lt;br&gt;이벤트 저장 / SSE 전송&lt;br&gt;&lt;br&gt;&lt;b&gt;Terraform·AI를 직접 실행하지 않아요&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3978BD;strokeWidth=2;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="435" width="330" height="255" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;PostgreSQL 17 · 영속 볼륨&lt;/b&gt;&lt;br&gt;JPA / Flyway / 읽기 전용 SQL&lt;br&gt;&lt;br&gt;배포·승인·명령·state 락·멱등 키&lt;br&gt;이력·이벤트 seq·AI 사용량·산출물 참조&lt;br&gt;DB 작업 가져오기: SKIP LOCKED" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E4F1E8;strokeColor=#669579;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="390" y="765" width="330" height="140" as="geometry"/></mxCell>
        <mxCell id="onpremApp" value="&lt;b&gt;온프레미스 대상 · Docker 앱&lt;/b&gt;&lt;br&gt;Terraform Docker provider / SSH&lt;br&gt;ngrok → onprem.unibloom.cloud&lt;br&gt;플랫폼 Compose와 별도로 관리해요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF4EF;strokeColor=#36A78B;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="390" y="935" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="jenkins" value="&lt;b&gt;Jenkins + Terraform CLI + Python&lt;/b&gt;&lt;br&gt;&lt;br&gt;daisy-ci&lt;br&gt;checkout → 테스트 → 이미지 빌드·푸시&lt;br&gt;&lt;br&gt;daisy-cd-plan&lt;br&gt;AI 생성 / 재사용 → validate·plan·위험 검사&lt;br&gt;&lt;br&gt;daisy-cd-apply&lt;br&gt;서버에서 승인한 plan → 환경별 병렬 적용&lt;br&gt;헬스체크 / 커밋 확인 / 결과 콜백&lt;br&gt;&lt;br&gt;Credentials에서 자격증명 주입&lt;br&gt;Jenkins 자체 사용자 승인 단계 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DA;strokeColor=#C18B3F;strokeWidth=2;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="810" y="275" width="350" height="340" as="geometry"/></mxCell>
        <mxCell id="artifacts" value="&lt;b&gt;러너 작업 파일 / 산출물 / 온프레미스 state&lt;/b&gt;&lt;br&gt;&lt;br&gt;기준 모듈 · 검증된 코드 · 승인 plan&lt;br&gt;서버에는 참조·digest·메타데이터 전달&lt;br&gt;온프레미스 state: 로컬 파일 + flock&lt;br&gt;tfplan / tfstate는 비밀값 포함 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EB;strokeColor=#D7AF70;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="810" y="695" width="350" height="135" as="geometry"/></mxCell>
        <mxCell id="lockNote" value="&lt;b&gt;두 종류의 잠금&lt;/b&gt;&lt;br&gt;&lt;br&gt;서버 target_lock: state_identity 기준 실행 충돌 방지&lt;br&gt;Terraform backend: 실제 state 저장·잠금&lt;br&gt;&lt;br&gt;단일 서버 워커 기준 / Redis 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7F5;strokeColor=#9DBFA9;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="810" y="885" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="github" value="&lt;b&gt;GitHub · 앱 저장소&lt;/b&gt;&lt;br&gt;Dockerfile / deploy.yaml&lt;br&gt;main 커밋 → Jenkins CI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E8DBB;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1260" y="215" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="registry" value="&lt;b&gt;Docker Hub&lt;/b&gt;&lt;br&gt;태그: 커밋 해시&lt;br&gt;이미지 digest 기록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E8DBB;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1510" y="215" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="claude" value="&lt;b&gt;Claude API&lt;/b&gt;&lt;br&gt;Terraform 생성·오류 수정 / 호출별 토큰·USD 비용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFB;strokeColor=#9E8DBB;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1260" y="355" width="470" height="75" as="geometry"/></mxCell>
        <mxCell id="aws" value="&lt;b&gt;AWS · ap-northeast-2 서울&lt;/b&gt;&lt;br&gt;고정 VPC / 서브넷 → ALB + ECS Fargate&lt;br&gt;HTTPS: aws.unibloom.cloud&lt;br&gt;&lt;br&gt;state: S3 / 네이티브 lockfile&lt;br&gt;이미지: Docker Hub에서 pull" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E0;strokeColor=#DCA455;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1260" y="550" width="470" height="145" as="geometry"/></mxCell>
        <mxCell id="gcp" value="&lt;b&gt;GCP · asia-northeast1 도쿄&lt;/b&gt;&lt;br&gt;Cloud Run / 도메인 매핑&lt;br&gt;HTTPS: gcp.unibloom.cloud&lt;br&gt;&lt;br&gt;state: GCS / backend 잠금&lt;br&gt;동일한 커밋의 앱 이미지 배포" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#6C9ED6;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1260" y="725" width="470" height="145" as="geometry"/></mxCell>
        <mxCell id="azure" value="&lt;b&gt;Azure · koreacentral 서울&lt;/b&gt;&lt;br&gt;Container Apps / 관리형 인증서&lt;br&gt;HTTPS: azure.unibloom.cloud&lt;br&gt;&lt;br&gt;state: Azure Blob / blob lease&lt;br&gt;동일한 커밋의 앱 이미지 배포" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F5FC;strokeColor=#57A5C8;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="1260" y="900" width="470" height="145" as="geometry"/></mxCell>
