        <mxCell id="e3" edge="1" parent="1" source="dedup" target="conflict" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#CB7066;exitX=1;exitY=0.8;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="dedup" target="atomic" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#3978BD;strokeWidth=2;exitX=0.5;exitY=0;entryX=0;entryY=0.05;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="195"/><mxPoint x="1180" y="195"/><mxPoint x="1180" y="225"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="DB에 남은 명령을 워커가 읽어요" edge="1" parent="1" source="atomic" target="pending" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#A66D24;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1475" y="495"/><mxPoint x="215" y="495"/></Array></mxGeometry></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="pending" target="claim" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#A66D24;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
