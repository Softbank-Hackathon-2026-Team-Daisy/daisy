        <mxCell id="e8" edge="1" parent="1" source="submit" target="accepted" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#589D71;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="접수 여부 불명" edge="1" parent="1" source="submit" target="unknown" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;dashed=1;strokeColor=#8867B0;html=1;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="805"/><mxPoint x="260" y="805"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="unknown" target="lookup" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#8867B0;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
