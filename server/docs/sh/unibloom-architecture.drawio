        <mxCell id="edge2" value="정적 파일" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#3978BD;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="gateway" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="335" y="575"/><mxPoint x="335" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="edge3" value="REST / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;endArrow=block;strokeColor=#3978BD;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.75;" edge="1" parent="1" source="gateway" target="server"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge4" value="트랜잭션 / 조회 / 이벤트 재생" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;strokeColor=#669579;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="server" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
