        <mxCell id="edge7" value="소스 checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#8C78A9;dashed=1;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1;entryX=0;entryY=0.5;" edge="1" parent="1" source="jenkins" target="github"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge8" value="이미지 push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#8C78A9;dashed=1;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0.5;entryY=1;" edge="1" parent="1" source="jenkins" target="registry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1215" y="343"/><mxPoint x="1620" y="343"/></Array></mxGeometry></mxCell>
        <mxCell id="edge9" value="AI 호출" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;endArrow=block;strokeColor=#8C78A9;dashed=1;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;entryX=0;entryY=0.5;" edge="1" parent="1" source="jenkins" target="claude"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge10" value="읽기·저장" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;strokeColor=#A66D24;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jenkins" target="artifacts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge11" value="AWS API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#A66D24;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;entryX=0;entryY=0.3;" edge="1" parent="1" source="jenkins" target="aws"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge12" value="GCP API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#A66D24;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.9;entryX=0;entryY=0.3;" edge="1" parent="1" source="jenkins" target="gcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="581"/><mxPoint x="1210" y="768"/></Array></mxGeometry></mxCell>
        <mxCell id="edge13" value="Azure API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#A66D24;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.95;entryX=0;entryY=0.3;" edge="1" parent="1" source="jenkins" target="azure"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="598"/><mxPoint x="1225" y="943"/></Array></mxGeometry></mxCell>
        <mxCell id="edge14" value="SSH · Docker provider" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#36A78B;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.98;entryX=1;entryY=0.5;" edge="1" parent="1" source="jenkins" target="onpremApp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="765" y="608"/><mxPoint x="765" y="985"/></Array></mxGeometry></mxCell>
        <mxCell id="footer" value="&lt;b&gt;담당 경계&lt;/b&gt;　프론트: 화면·API 연결　|　은현: 인증·관리·공개 조회　|　승환: 실행 규칙·Jenkins 연동·락·복구·SSE / 서버 통합　|　인프라: AI·Terraform·실행 환경&lt;br&gt;&lt;br&gt;&lt;b&gt;기준&lt;/b&gt;　2026-10-03 · main a8c379c 및 #89 후속 보고. 네 환경 웹 배포·state 일치 확인은 인프라 보고 기준이며, 이 그림 작성 중 실배포를 다시 실행하지 않았어요.&lt;br&gt;&lt;b&gt;범위&lt;/b&gt;　현재 HelloCalc 데모 구성. 앱 DB(RDS·Cloud SQL), Redis, Kubernetes, 임의 저장소 CI 자동 설정은 추가하지 않았어요. 계정 ID·키·버킷 실명은 생략했어요.&lt;br&gt;&lt;b&gt;구분&lt;/b&gt;　사용자 앱 CI/CD와 Unibloom 플랫폼 자체의 웹·서버 Compose 갱신은 별개예요. 클라이언트는 배포 결과의 공개 URL로 앱에 직접 접속해요." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#D6DEE8;align=left;spacing=15;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="1710" height="155" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="deployment-flow" name="02 전체 흐름 · 빌드 / 생성 / 승인 / 배포">
    <mxGraphModel dx="1800" dy="1430" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1430" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="UNIBLOOM | 요청부터 4환경 결과까지" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#142D4E;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1710" height="55" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="실선: 실행 흐름　점선: 결과·진행 전달 또는 재계획　노란색: 사용자 승인　각 상자는 담당 파트 안에서 수행하는 단계예요" style="text;html=1;align=left;fontSize=16;fontColor=#516175;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1710" height="35" as="geometry"/></mxCell>
        <mxCell id="laneWeb" value="사용자 · 웹 / 앱" style="swimlane;startSize=45;html=1;fillColor=#EAF2FF;swimlaneFillColor=#F8FBFF;strokeColor=#ADC7EB;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="1110" as="geometry"/></mxCell>
        <mxCell id="laneServer" value="Spring Boot · PostgreSQL" style="swimlane;startSize=45;html=1;fillColor=#E4F1E8;swimlaneFillColor=#F8FCF9;strokeColor=#9DBFA9;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="410" height="1110" as="geometry"/></mxCell>
        <mxCell id="laneInfra" value="Jenkins · AI · Terraform" style="swimlane;startSize=45;html=1;fillColor=#FFF0DA;swimlaneFillColor=#FFFCF7;strokeColor=#D7AF70;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="150" width="470" height="1110" as="geometry"/></mxCell>
        <mxCell id="laneTarget" value="4개 배포 대상" style="swimlane;startSize=45;html=1;fillColor=#EDE8F7;swimlaneFillColor=#FBFAFE;strokeColor=#BEAED7;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="150" width="380" height="1110" as="geometry"/></mxCell>
        <mxCell id="commit" value="&lt;b&gt;① 앱 저장소 main 변경&lt;/b&gt;&lt;br&gt;Dockerfile + deploy.yaml&lt;br&gt;CI 실행 연결은 Jenkins 설정 기준" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C9ED6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="65" y="230" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="ci" value="&lt;b&gt;② daisy-ci&lt;/b&gt;&lt;br&gt;checkout → 테스트 → 이미지 빌드&lt;br&gt;커밋 태그·digest → Docker Hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DA;strokeColor=#C18B3F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="905" y="230" width="400" height="95" as="geometry"/></mxCell>
        <mxCell id="build" value="&lt;b&gt;빌드 결과 저장&lt;/b&gt;&lt;br&gt;POST /internal/jenkins/builds&lt;br&gt;source_version / 서비스별 image_refs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1E8;strokeColor=#669579;fontSize=16;" vertex="1" parent="1"><mxGeometry x="455" y="350" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="select" value="&lt;b&gt;③ 빌드·환경 선택 → 배포&lt;/b&gt;&lt;br&gt;source_version_id + target_ids&lt;br&gt;AWS / GCP / Azure / 온프레미스" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C9ED6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="65" y="470" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="intake" value="&lt;b&gt;④ 배포 접수·명령 저장&lt;/b&gt;&lt;br&gt;인가 / Idempotency-Key / 입력 고정&lt;br&gt;DB 워커 → request_id + payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1E8;strokeColor=#669579;fontSize=16;" vertex="1" parent="1"><mxGeometry x="455" y="470" width="360" height="95" as="geometry"/></mxCell>
        <mxCell id="plan" value="&lt;b&gt;⑤ daisy-cd-plan · 환경별 수행&lt;/b&gt;&lt;br&gt;기준 모듈 + deploy.yaml&lt;br&gt;Claude 생성 / 검증된 코드 재사용&lt;br&gt;validate → plan → 위험 검사&lt;br&gt;실패 시 AI 수정, 최초 포함 총 3회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DA;strokeColor=#C18B3F;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="905" y="465" width="400" height="155" as="geometry"/></mxCell>
        <mxCell id="planStore" value="&lt;b&gt;⑥ 인증된 plan 콜백 수신&lt;/b&gt;&lt;br&gt;요약·위험·digest·입력 hash·기한 저장&lt;br&gt;대상별 승인 요청 생성 / SSE 알림" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1E8;strokeColor=#669579;fontSize=16;" vertex="1" parent="1"><mxGeometry x="455" y="650" width="360" height="95" as="geometry"/></mxCell>
        <mxCell id="approve" value="&lt;b&gt;⑦ plan 확인 → 승인 / 거절&lt;/b&gt;&lt;br&gt;생성·변경·삭제 / 위험 확인&lt;br&gt;대상별 approval_id를 서버에 전달" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2B3;strokeColor=#C6A445;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="65" y="790" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="guard" value="&lt;b&gt;⑧ 승인 검증·state 락&lt;/b&gt;&lt;br&gt;본 plan·digest·기한·권한 대조&lt;br&gt;거절: apply 요청 없음&lt;br&gt;승인: apply 명령 DB 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1E8;strokeColor=#669579;strokeWidth=2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="455" y="790" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="apply" value="&lt;b&gt;⑨ daisy-cd-apply&lt;/b&gt;&lt;br&gt;승인 plan·입력 대조 → 환경별 병렬 apply&lt;br&gt;이미지 배포 → 헬스·커밋 확인&lt;br&gt;stale이면 적용 없이 재-plan·재승인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DA;strokeColor=#C18B3F;fontSize=16;" vertex="1" parent="1"><mxGeometry x="905" y="790" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="targets" value="&lt;b&gt;AWS · ECS Fargate / ALB&lt;/b&gt;&lt;br&gt;S3 state&lt;br&gt;&lt;br&gt;&lt;b&gt;GCP · Cloud Run&lt;/b&gt;&lt;br&gt;GCS state&lt;br&gt;&lt;br&gt;&lt;b&gt;Azure · Container Apps&lt;/b&gt;&lt;br&gt;Blob state&lt;br&gt;&lt;br&gt;&lt;b&gt;온프레미스 · Docker&lt;/b&gt;&lt;br&gt;러너 로컬 state&lt;br&gt;&lt;br&gt;각 환경은 자체 state 잠금을 사용해요&lt;br&gt;한 환경 실패가 다른 환경을 막지 않아요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAFB;strokeColor=#9E8DBB;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1395" y="645" width="330" height="365" as="geometry"/></mxCell>
        <mxCell id="finish" value="&lt;b&gt;⑩ 결과 검증·상태 확정&lt;/b&gt;&lt;br&gt;대상 결과·승인 증거·이미지 대조&lt;br&gt;성공 시 현재 배포·연결 확인 갱신&lt;br&gt;실행 종료 확인 후 소유 락 해제&lt;br&gt;로그·AI 사용량 저장 / SSE 전달" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F1E8;strokeColor=#669579;fontSize=16;" vertex="1" parent="1"><mxGeometry x="455" y="1040" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="result" value="&lt;b&gt;⑪ 진행 / 결과 / 이력 표시&lt;/b&gt;&lt;br&gt;환경별 성공·실패 / 공개 URL&lt;br&gt;이미지 digest / 현재 버전 / AI 비용&lt;br&gt;&lt;br&gt;공개 URL → 배포된 앱 직접 접속" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C9ED6;fontSize=16;" vertex="1" parent="1"><mxGeometry x="65" y="1040" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="infraNote" value="&lt;b&gt;재사용도 새 plan·승인이 필요해요&lt;/b&gt;&lt;br&gt;재사용: AI 호출 0회&lt;br&gt;단순 stale 재-plan: attempt 증가 없음&lt;br&gt;생성·수정 3회 소진: 해당 환경 중단" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EB;strokeColor=#D7AF70;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="905" y="1060" width="400" height="110" as="geometry"/></mxCell>
        <mxCell id="contractNote" value="&lt;b&gt;서버 ↔ Jenkins&lt;/b&gt;&lt;br&gt;&lt;br&gt;명령: REST API + request_id&lt;br&gt;결과: 서비스 토큰 인증 콜백&lt;br&gt;복구: queue / build 상태 폴링&lt;br&gt;&lt;br&gt;Jenkins SUCCESS만으로&lt;br&gt;대상 배포 성공을 만들지 않아요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BEAED7;dashed=1;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1395" y="245" width="330" height="210" as="geometry"/></mxCell>
        <mxCell id="f1" value="CI 실행" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#60758B;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="commit" target="ci"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" value="빌드 보고" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#A66D24;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="ci" target="build"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" value="빌드 이력 조회" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#3978BD;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="build" target="select"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" value="POST" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#3978BD;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="select" target="intake"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" value="prepare" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#3978BD;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="intake" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" value="plan・단계・로그・사용량" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#A66D24;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="plan" target="planStore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f7" value="승인 요청 표시" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#3978BD;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="planStore" target="approve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f8" value="승인 API" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#B59426;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="approve" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f9" value="apply" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#3978BD;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="guard" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f10" value="병렬 실행" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#A66D24;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apply" target="targets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f11" value="헬스·버전 확인" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeColor=#A66D24;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.85;entryY=1;" edge="1" parent="1" source="targets" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="1025"/><mxPoint x="1245" y="1025"/></Array></mxGeometry></mxCell>
        <mxCell id="f12" value="검증된 결과 콜백" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#A66D24;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apply" target="finish"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="980"/><mxPoint x="635" y="980"/></Array></mxGeometry></mxCell>
        <mxCell id="f13" value="SSE / 조회" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#3978BD;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="finish" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="footer" value="&lt;b&gt;실패·복구 규칙&lt;/b&gt;　응답 유실은 unknown으로 추적하고 무조건 재실행하지 않아요. 취소·중단 요청은 실제 종료와 구분해요. 재시도·롤백은 새 배포이며 plan 승인을 다시 받아요.&lt;br&gt;&lt;br&gt;&lt;b&gt;최근 검증 보고 (#89)&lt;/b&gt;　plan #33: 재사용·AI 0회 → apply #17: 네 환경 성공·헬스 200 / 네 대상 state_identity 실제 값 정렬 / 불일치 경고 0건.&lt;br&gt;이는 인프라팀이 보고한 정상 흐름 검증 결과예요. 모든 장애·취소·복구 시나리오의 실환경 검증 완료를 뜻하지는 않아요." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F9;strokeColor=#D6DEE8;align=left;spacing=15;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="1710" height="115" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="execution-safety" name="03 승환 담당 · 멱등성 / DB 큐 / 복구">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="승환 담당 | 같은 요청은 한 번 접수하고, 불확실한 실행은 확인해요" style="text;html=1;align=left;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1720" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="멱등성 = 중복 접수 방지 · DB 큐 = 명령 보존과 비동기 전달 · state 락 = 같은 인프라의 동시 변경 방지 · 복구 = 응답 유실 후 실행 추적" style="text;html=1;align=left;fontSize=17;fontColor=#526174;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1720" height="45" as="geometry"/></mxCell>
        <mxCell id="txn" value="1. API 접수 — 하나의 DB 트랜잭션" style="swimlane;html=1;startSize=40;horizontal=1;rounded=1;fillColor=#EAF2FF;swimlaneFillColor=#F8FAFF;strokeColor=#91B6E3;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="1720" height="330" as="geometry"/></mxCell>
        <mxCell id="request" value="&lt;b&gt;배포·승인·제어 POST&lt;/b&gt;&lt;br&gt;인증·권한 확인&lt;br&gt;Idempotency-Key + 요청 본문" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3978BD;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="65" y="245" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="dedup" value="&lt;b&gt;프로젝트 행 잠금 → 기존 키 조회&lt;/b&gt;&lt;br&gt;actor · project · operation&lt;br&gt;resource · key 범위로 식별&lt;br&gt;정규화한 요청의 hash 비교" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3978BD;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="370" y="235" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="replay" value="&lt;b&gt;같은 키 + 같은 요청&lt;/b&gt;&lt;br&gt;저장된 HTTP 상태·본문 반환&lt;br&gt;배포·명령을 새로 만들지 않아요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#589D71;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="775" y="205" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="conflict" value="&lt;b&gt;같은 키 + 다른 요청&lt;/b&gt;&lt;br&gt;409 STATE_CONFLICT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#CB7066;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="775" y="345" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="atomic" value="&lt;b&gt;새 키: 업무 검사 후 원자 저장&lt;/b&gt;&lt;br&gt;배포 / 승인 변경 + 이벤트&lt;br&gt;jenkins_execution: pending&lt;br&gt;멱등 응답 저장 → COMMIT&lt;br&gt;&lt;br&gt;실패하면 함께 롤백해요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#3978BD;strokeWidth=2;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="1240" y="215" width="470" height="200" as="geometry"/></mxCell>
        <mxCell id="newNote" value="새 키 경로 →" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1100" y="210" width="130" height="30" as="geometry"/></mxCell>
        <mxCell id="queueBox" value="2. DB 작업 큐 → 워커 → Jenkins — 외부 HTTP는 DB 트랜잭션 밖에서" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#FFF0DA;swimlaneFillColor=#FFFCF7;strokeColor=#D5AE75;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1720" height="265" as="geometry"/></mxCell>
        <mxCell id="pending" value="&lt;b&gt;Postgres 작업 테이블&lt;/b&gt;&lt;br&gt;jenkins_execution&lt;br&gt;pending 명령 + 고정 입력&lt;br&gt;request_id를 DB에 보존" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#A66D24;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="295" height="130" as="geometry"/></mxCell>
        <mxCell id="claim" value="&lt;b&gt;워커가 명령 확보&lt;/b&gt;&lt;br&gt;FOR UPDATE SKIP LOCKED&lt;br&gt;apply는 승인 유효성 재확인&lt;br&gt;dispatching 기록 → COMMIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A66D24;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="submit" value="&lt;b&gt;Jenkins에 HTTP 제출&lt;/b&gt;&lt;br&gt;Job + request_id + 고정 입력&lt;br&gt;DB 트랜잭션은 이미 끝났어요&lt;br&gt;Terraform은 Jenkins가 실행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DA;strokeColor=#A66D24;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="870" y="610" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="accepted" value="&lt;b&gt;접수 응답이 확인되면&lt;/b&gt;&lt;br&gt;accepted + queue_id 저장&lt;br&gt;이후 build_number 연결&lt;br&gt;폴링·콜백으로 진행 추적" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#589D71;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="1310" y="610" width="400" height="130" as="geometry"/></mxCell>
        <mxCell id="recoveryBox" value="3. 응답 유실·서버 재시작 — 실패로 단정하거나 즉시 재실행하지 않아요" style="swimlane;html=1;startSize=40;rounded=1;fillColor=#F1EAFA;swimlaneFillColor=#FCFAFF;strokeColor=#AF98CD;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1720" height="260" as="geometry"/></mxCell>
        <mxCell id="unknown" value="&lt;b&gt;접수 여부를 모르면 unknown&lt;/b&gt;&lt;br&gt;타임아웃 / 제출 후 응답 유실&lt;br&gt;재시작 시 남은 dispatching도&lt;br&gt;unknown으로 복구해요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8867B0;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="905" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="lookup" value="&lt;b&gt;기존 request_id로 조회&lt;/b&gt;&lt;br&gt;Jenkins 큐·빌드 검색&lt;br&gt;새 실행 요청은 보내지 않아요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8867B0;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="530" y="915" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="found" value="&lt;b&gt;기존 실행을 찾음&lt;/b&gt;&lt;br&gt;queue_id / build_number 연결&lt;br&gt;같은 실행의 추적을 이어가요" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#589D71;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="960" y="895" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="unconfirmed" value="&lt;b&gt;미발견·모호함·조회 실패&lt;/b&gt;&lt;br&gt;unknown 유지 후 다시 확인&lt;br&gt;미발견 ≠ 실행되지 않았다는 증거&lt;br&gt;종료 확인 전 state 락 유지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#CB7066;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry x="1380" y="895" width="330" height="145" as="geometry"/></mxCell>
        <mxCell id="locks" value="&lt;b&gt;서로 다른 3가지 보호&lt;/b&gt;&lt;br&gt;① 멱등 키: 같은 요청의 재전송 → 기존 응답&lt;br&gt;② DB 큐의 행 잠금: 명령 확보 경합 제어&lt;br&gt;③ target_lock: 같은 state_identity 동시 변경 차단&lt;br&gt;승인 시 확보 → 종료 근거 확인 후 소유 ID로 해제&lt;br&gt;별도로 Terraform backend도 state를 잠가요" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=18;fillColor=#EAF2FF;strokeColor=#91B6E3;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="820" height="190" as="geometry"/></mxCell>
        <mxCell id="limits" value="&lt;b&gt;보장 범위·설명할 때 주의할 점&lt;/b&gt;&lt;br&gt;DB 큐 자체가 멱등성을 보장하는 것은 아니에요.&lt;br&gt;서로 다른 키의 요청은 별도 요청이며 업무 규칙·락으로 제어해요.&lt;br&gt;DB와 Jenkins를 하나의 트랜잭션으로 묶지 않아요.&lt;br&gt;불확실한 실행을 보수적으로 추적하며 exactly-once를 주장하지 않아요.&lt;br&gt;현재 워커는 단일 백엔드 프로세스 운영 전제예요." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=18;fillColor=#F4F6F9;strokeColor=#D6DEE8;fontSize=17;" vertex="1" parent="1"><mxGeometry x="900" y="1130" width="860" height="190" as="geometry"/></mxCell>
        <mxCell id="source" value="코드 근거: IdempotencyService.execute · DeploymentExecutionService · JenkinsCommandService.claimPending / recoverDispatching · JenkinsWorker.dispatch / reconcile" style="text;html=1;align=left;fontSize=14;fontColor=#526174;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1720" height="35" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="request" target="dedup" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#3978BD;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
