        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ がどの環境でどのバージョンで動いているか、次に何をすべきかを確認します。"
          }
        }
      }
    },
    "%@는 %lld번 모두 실패해서 멈췄어요. %@는 그대로 계속 진행해요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
