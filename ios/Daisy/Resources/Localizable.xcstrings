        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は成功し、%2$@ は apply で失敗しました。成功した環境同士が同じイメージか確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
