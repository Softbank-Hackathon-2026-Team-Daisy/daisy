# 복사해서 .env.local로 쓰세요 (.env.local은 커밋하지 않아요)
# 서버 주소 — 비우면 같은 origin으로 요청해요
VITE_API_BASE_URL=
# 기본 true = 전부 목업. false = 서버에 열린 API만 실서버, 아직 없는 API는 목업 + MOCK 배지
# 로컬 서버면 VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_USE_MOCK=true
# 개발 서버(https://api.unibloom.cloud)에 붙을 때 — 개발 API가 localhost를 CORS로 막아서 Vite 프록시를 거쳐요
# VITE_API_BASE_URL=/api
# VITE_PROXY_TARGET=https://api.unibloom.cloud
# VITE_USE_MOCK=false
